# DEMO SEED (PR set): deliberately misconfigured resources, used to demonstrate IaC scanning in a pull request.
# Never apply. Applied/removed by scripts/demo-seed.sh.

resource "aws_s3_bucket" "uploads" {
  bucket = "frogstatus-uploads"
}

resource "aws_s3_bucket_acl" "uploads" {
  bucket = aws_s3_bucket.uploads.id
  acl    = "public-read-write"
}

resource "aws_db_instance" "reports" {
  allocated_storage   = 20
  engine              = "postgres"
  instance_class      = "db.t3.micro"
  publicly_accessible = true
  storage_encrypted   = false
}
