# Copy to ~/.config/frogstatus-demo/secrets (outside the repo, so scanners and
# accidental commits never see it) and fill in.
#
# DEMO_GITHUB_TOKEN: use a REVOKED GitHub PAT. It keeps the real token format, so the
#   secrets scanner flags it, and dynamic token validation reports it as Inactive.
# DEMO_DB_PASSWORD: any dummy password for the seeded Dockerfile.
DEMO_GITHUB_TOKEN=ghp_replace_with_a_revoked_token
DEMO_DB_PASSWORD=Password123
